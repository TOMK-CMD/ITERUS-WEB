{
  "name": "iterus-web",
  "version": "1.0.0",
  "private": true,
  "description": "Website of Iterus — AI-native software studio, Prague. pnpm workspace: apps/web (Next.js), packages/ui (tokens + components).",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.18 <23",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter web test",
    "test:e2e": "pnpm --filter web test:e2e",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:schema": "node scripts/check-schema.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:quick": "pnpm typecheck && pnpm lint",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm check:i18n"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "gray-matter": "4.0.3",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1"
  }
}
