# Every variable the site reads (docs/RUNBOOK.md → Environment variables is the source of truth).
# Values live in Vercel (Project → Settings → Environment Variables) and locally in
# apps/web/.env.local (gitignored). This file is committed on purpose and must stay value-free.

# Canonical origin — canonical URLs, hreflang, sitemap, robots, llms.txt, OG images.
NEXT_PUBLIC_SITE_URL=https://iterus.cz

# Plausible analytics (cookieless). Unset → no script is rendered.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Cloudflare Turnstile — the public site key renders the widget, the secret verifies server-side.
# Cloudflare test keys (always pass): site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend — outbound mail for the contact form. From must be on a verified domain.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="Iterus web <noreply@iterus.cz>"

# Cal.com booking page (full URL). Unset → the booking call-to-action is not rendered.
NEXT_PUBLIC_CALCOM_LINK=

# IndexNow key for scripts/indexnow.mjs (the key file must be served at /<key>.txt). Unset → no-op.
INDEXNOW_KEY=
